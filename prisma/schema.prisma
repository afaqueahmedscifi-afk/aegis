generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Branch {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  city      String?
  isActive  Boolean    @default(true)
  incidents Incident[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Incident {
  id          String   @id @default(cuid())
  reference   String   @unique
  title       String
  description String?
  category    String
  severity    String   @default("Medium")
  status      String   @default("Open")
  owner       String?
  evidence    String?
  notes       String?
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([branchId, status])
  @@index([severity, status])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}